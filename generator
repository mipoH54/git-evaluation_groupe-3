#!/usr/bin/env python3
import sys
import random

Minimum = 1
Maximum = 1000
Operations = ["+", "-", "*", "/"]

def affiche_utilisation() -> None:
    print("Utilisation: ./generator <nombre d'expressions>", file=sys.stderr)

def verifier_arg(argv: list[str]) -> tuple[int |None, str | None]:
    if len(argv) != 2:
        return None, "Argument manquant."
    try:
        nb = int(argv[1])
    except ValueError:
        return None, "L'argument doit être un entier."
    if nb < 0:
        return None, "Le nombre d'expressions doit être >= 0."
    return nb, None

def tirage_operation() -> str:
    return random.choice(Operations)

def generer_operation(nb_expressions: int) -> str:
    for _ in range(nb_expressions):
        a = random.randint(Minimum, Maximum)
        b = random.randint(Minimum, Maximum)
        op = tirage_operation()
        print(f"{a}{op}{b}") 

def main(argv: list[str]) -> int:
    nb_expressions = int(argv[1])
    generer_operation(nb_expressions)
    return 0

if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
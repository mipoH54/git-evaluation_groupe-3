import re

# Fonction de parsing pour les lignes données
def parse_expression(line: str):
    line = line.strip()

    # regex pour capturer : nombre opérateur nombre
    match = re.fullmatch(r'(\d+)\s*([\+\-\*/])\s*(\d+)', line)

    if not match:
        return None

    a = float(match.group(1))
    op = match.group(2)
    b = float(match.group(3))

    return a, op, b


# Fonction des opérations élémentaires
def compute(a, op, b):
    if op == '+':       # Addition
        return a + b
    elif op == '-':     # Soustraction
        return a - b
    elif op == '*':     # Multiplication
        return a * b
    elif op == '/':     # Division
        if b == 0:
            return None  # division par zéro
        return a / b


